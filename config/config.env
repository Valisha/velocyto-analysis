# Read-only input paths.
INPUT_PROJECT_DIR="/data/aaliu/Projects/IGSC scRNAseq exp1"
FASTQ_DIR="${INPUT_PROJECT_DIR}/raw data"

# Writable output paths. By default, all generated data stays under the current
# repository clone (for example /data/vashah/Aaron/RNA_VELOCITY).
WORK_ROOT="${WORK_ROOT:-${REPO_DIR}}"
QUANT_ROOT="${WORK_ROOT}/velocyto_analysis_pipeline"
ANALYSIS_ROOT="${WORK_ROOT}/rna_velocity"

# Reuse the exact mm10 splici reference from Irene Exp2. REFERENCE_ROOT can be
# overridden in the environment if the reference is moved.
REFERENCE_ROOT="${REFERENCE_ROOT:-/data/vashah/CELLRANGER_PIPELINE/Input_data_to_pipeline/velocyto_pipeline}"
SALMON_INDEX="${REFERENCE_ROOT}/mm10-2.1.0_splici_fl146_idx"
T2G_3COL="${REFERENCE_ROOT}/mm10_2.1.0_splici_fl146/splici_fl146_t2g_3col.tsv"
OUTPUT_PREFIX="IGSC_Exp1"

# Compute settings; tune to the cluster allocation.
LOCAL_CORES=16
LOCAL_MEM_GB=64

# Commands may be replaced with executable names or absolute executable paths.
SALMON_CMD="salmon"
ALEVIN_FRY_CMD="alevin-fry"
PYTHON_CMD="python"

# Optional final-analysis settings. Cell IDs in ANNOTATION_H5AD must be
# SAMPLE:BARCODE (for example E2:AAAC...-1).
ANNOTATION_H5AD=""
PLOT_COLOR="sample"
ROOT_KEY="cell_type"
ROOT_CLUSTER=""
ROOT_CELL=""
