# Cluster paths. This repository should be copied directly inside Irene/.
PROJECT_DIR="/data/aaliu/Projects/IGSC scRNAseq exp1"
FASTQ_DIR="${PROJECT_DIR}/raw data"
IRENE_DIR="${IRENE_DIR:-$(cd "${REPO_DIR}/.." && pwd)}"
QUANT_ROOT="${PROJECT_DIR}/velocyto_analysis_pipeline"
ANALYSIS_ROOT="${PROJECT_DIR}/rna_velocity"

# Reuse the exact mm10 splici reference from Irene Exp2.
SALMON_INDEX="${IRENE_DIR}/mm10-2.1.0_splici_fl146_idx"
T2G_3COL="${IRENE_DIR}/mm10_2.1.0_splici_fl146/splici_fl146_t2g_3col.tsv"
TEMPLATE_QUANT_JSON="${IRENE_DIR}/velocyto_analysis_pipeline/Irene_Exp2_Pool2_quant_res/quant.json"
TEMPLATE_PERMIT_JSON="${IRENE_DIR}/velocyto_analysis_pipeline/Irene_Exp2_Pool2_quant/generate_permit_list.json"
OUTPUT_PREFIX="IGSC_Exp1"

# Compute settings; tune to the cluster allocation.
LOCAL_CORES=16
LOCAL_MEM_GB=64

# Commands may be replaced with executable names or absolute executable paths.
SALMON_CMD="salmon"
ALEVIN_FRY_CMD="alevin-fry"
PYTHON_CMD="python"

# Optional final-analysis settings. Cell IDs in ANNOTATION_H5AD must be
# SAMPLE:BARCODE (for example E2:AAAC...-1).
ANNOTATION_H5AD=""
PLOT_COLOR="sample"
ROOT_KEY="cell_type"
ROOT_CLUSTER=""
ROOT_CELL=""
